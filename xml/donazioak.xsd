<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- IzenMota definitu: 1-150 karaktere -->
    <xs:simpleType name="IzenMota">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="150"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- IFK formatua: Letra bat + 8 digitu -->
    <xs:simpleType name="ifkMota">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{8}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Erreferentzia formatua: IR, EZ edo EI + 5 digitu -->
    <xs:simpleType name="erreferentziaMota">
        <xs:restriction base="xs:string">
            <xs:pattern value="(IR|EZ|EI)[0-9]{5}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Bai/Ez mota -->
    <xs:simpleType name="baiEzMota">
        <xs:restriction base="xs:string">
            <xs:enumeration value="BAI"/>
            <xs:enumeration value="EZ"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Elikagai mota -->
    <xs:simpleType name="motaMota">
        <xs:restriction base="xs:string">
            <xs:enumeration value="iragankorra"/>
            <xs:enumeration value="ez iragankorra"/>
            <xs:enumeration value="erdi iragankorra"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="donazioak">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="donazioa" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="enpresa_emailea">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="ifk" type="ifkMota"/>
                                        <xs:element name="enpresaren_izena" type="IzenMota"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="data" type="xs:date"/>
                            <xs:element name="elikagaiak">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="elikagaia" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="erreferentzia" type="erreferentziaMota"/>
                                                    <xs:element name="produktuaren_izena" type="IzenMota"/>
                                                    <xs:element name="kopurua" type="xs:positiveInteger"/>
                                                    <xs:element name="manufakturatzen_duen_enpresa" type="IzenMota"/>
                                                    <!-- Hautazkoak elikagai motaren arabera -->
                                                    <xs:element name="iraungitze_data" type="xs:date" minOccurs="0"/>
                                                    <xs:element name="hoztuta_mantendu" type="baiEzMota" minOccurs="0"/>
                                                    <xs:element name="kontserba" type="baiEzMota" minOccurs="0"/>
                                                </xs:sequence>
                                                <!-- Mota atributu gisa -->
                                                <xs:attribute name="mota" type="motaMota" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
